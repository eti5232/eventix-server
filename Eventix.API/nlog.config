<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- One layout for all targets. CorrelationId comes from the logging scope opened by CorrelationIdMiddleware. -->
  <variable name="logLayout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${scopeproperty:CorrelationId:whenEmpty=-}|${message}${onexception:${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${logLayout}" />

    <!-- A new file every day; files older than 7 days are deleted. -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/eventix-${shortdate}.log"
            layout="${logLayout}"
            maxArchiveFiles="7"
            maxArchiveDays="7"
            encoding="utf-8" />
  </targets>

  <rules>
    <!-- Startup messages ("Now listening on...") are useful, keep them. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

    <!-- EF Core: the SQL text lives only in the Database.Command category, so it is hidden at every level. -->
    <logger name="Microsoft.EntityFrameworkCore.Database.Command" minlevel="Trace" final="true" />

    <!-- EF Core: Error and above are hidden, because ExceptionHandlingMiddleware already logs the full exception once
         (and a cancelled request is not an error). EF warnings are NOT matched here, so they continue to the rules below. -->
    <logger name="Microsoft.EntityFrameworkCore.*" minlevel="Error" final="true" />

    <!-- Other framework noise is hidden below Warning. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />

    <!-- Our own code: Information and above. -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
